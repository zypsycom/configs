{
  "name": "@zypsy/configs",
  "version": "0.1.0",
  "description": "Zypsy's shared oxlint, oxfmt and TypeScript configuration",
  "keywords": [
    "oxlint",
    "oxfmt",
    "oxc",
    "lint",
    "format",
    "tsconfig",
    "typescript",
    "react",
    "nextjs",
    "config"
  ],
  "homepage": "https://github.com/zypsycom/configs#readme",
  "bugs": {
    "url": "https://github.com/zypsycom/configs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zypsycom/configs.git"
  },
  "license": "MIT",
  "author": "Zypsy",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./oxlint": {
      "types": "./dist/oxlint/index.d.ts",
      "default": "./dist/oxlint/index.js"
    },
    "./oxlint-plugin": {
      "types": "./dist/oxlint/plugin.d.ts",
      "default": "./dist/oxlint/plugin.js"
    },
    "./oxfmt": {
      "types": "./dist/oxfmt/index.d.ts",
      "default": "./dist/oxfmt/index.js"
    },
    "./tsconfig/next.json": "./dist/tsconfig/next.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --disable-nested-config --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc",
    "test": "node --test test/*.test.ts",
    "prepack": "pnpm build",
    "prepush": "pnpm build && pnpm lint:fix && pnpm format && pnpm typecheck && pnpm test"
  },
  "peerDependencies": {
    "@oxlint/plugins": "^1.88.0",
    "oxfmt": ">=0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": ">=7.0.2004",
    "typescript": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@oxlint/plugins": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oxlint/plugins": "1.88.0",
    "@types/node": "^24.19.1",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "^7.0.2",
    "vite-plus": "1.2.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.9.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
